# Copier ce fichier en ".env" puis renseigner les valeurs.
# Le fichier .env n'est JAMAIS versionne (voir .gitignore).
# NE JAMAIS mettre de vraie cle dans CE fichier : il est publie sur GitHub.

# Cle d'API Groq : https://console.groq.com -> API Keys
AIREADY_GROQ_API_KEY=

# Fournisseur du modele de raisonnement : groq (defaut) ou ollama
AIREADY_LLM_PROVIDER=groq
