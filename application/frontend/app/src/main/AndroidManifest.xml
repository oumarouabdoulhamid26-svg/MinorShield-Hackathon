<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- L'app parent ne fait ni capture d'écran ni surveillance : elle consulte
         le backend et reçoit des alertes. Les permissions de surveillance
         (MediaProjection, overlay, usage stats...) appartiennent à l'app enfant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MinorShieldApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinorShield"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- ── Splash ── -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MinorShield.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Choix du rôle de l'appareil (1er démarrage, définitif) ── -->
        <activity
            android:name=".ui.RoleChoiceActivity"
            android:exported="false" />

        <!-- ── Onboarding ── -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:noHistory="true" />

        <!-- ── Auth ── -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.VerifyEmailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PinLoginActivity"
            android:exported="false" />

        <!-- ── Connexion (email + mot de passe) ── -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <!-- ── Fiche détaillée d'un enfant ── -->
        <activity
            android:name=".ui.ChildDetailActivity"
            android:exported="false"
            android:label="Fiche enfant" />

        <!-- ── App principale (4 onglets) ── -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- ── Pairing ── -->
        <activity
            android:name=".ui.pairing.PairingActivity"
            android:exported="false"
            android:label="@string/title_pairing" />

        <!-- ── Sous-écrans ── -->
        <activity
            android:name=".ui.SubscriptionActivity"
            android:exported="false"
            android:label="@string/title_subscription" />

        <!-- ── Notifications push (alertes envoyées par le backend) ── -->
        <service
            android:name=".notification.MinorShieldMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
