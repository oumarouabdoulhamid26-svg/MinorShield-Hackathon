<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo MinorShield -->
    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/logo_minorshield_round" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/title_login"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/lbl_enter_pin"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Dots PIN -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/dot1" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
        <View android:id="@+id/dot2" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
        <View android:id="@+id/dot3" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
        <View android:id="@+id/dot4" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
        <View android:id="@+id/dot5" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
        <View android:id="@+id/dot6" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/dot_pin_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/accent_red"
        android:textSize="13sp"
        android:text="" />

    <!-- Clavier PIN -->
    <GridLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        android:rowCount="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key1" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="1" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key2" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="2" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key3" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="3" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key4" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="4" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key5" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="5" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key6" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="6" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key7" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="7" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key8" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="8" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key9" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="9" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>

        <View android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key0" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="0" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyDelete" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:layout_height="64dp"
            android:text="⌫" android:textSize="22sp" android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_variant" app:cornerRadius="16dp"/>

    </GridLayout>

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lbl_forgot_password"
        android:textColor="@color/teal"
        android:textSize="14sp"
        android:padding="8dp" />

</LinearLayout>
