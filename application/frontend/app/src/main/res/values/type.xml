<?xml version="1.0" encoding="utf-8"?>
<!--
    Échelle typographique MinorShield.

    L'application comptait 16 tailles écrites à la main (10 → 36sp), sans
    aucun style partagé : chaque écran réinventait sa hiérarchie. Ces 7 niveaux
    couvrent tous les usages réels et doivent être utilisés via
    android:textAppearance plutôt qu'un android:textSize en dur.

    Graisses : sans-serif (regular) · sans-serif-medium · bold.
-->
<resources>

    <!-- Grands chiffres et compteurs (statistiques, score) -->
    <style name="TextAppearance.MinorShield.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Titre d'écran -->
    <style name="TextAppearance.MinorShield.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Titre de section / de carte -->
    <style name="TextAppearance.MinorShield.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Texte courant -->
    <style name="TextAppearance.MinorShield.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Texte secondaire, descriptions -->
    <style name="TextAppearance.MinorShield.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Métadonnées : horodatage, légendes -->
    <style name="TextAppearance.MinorShield.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Étiquettes en capitales (badges, en-têtes de section) -->
    <style name="TextAppearance.MinorShield.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Boutons -->
    <style name="TextAppearance.MinorShield.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>
