<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MinorShieldEnfant" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/navy_deep</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/enfant_background</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Typographie : même échelle que l'app parent -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.MinorShield.Title</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.MinorShield.Subtitle</item>
        <item name="textAppearanceBody1">@style/TextAppearance.MinorShield.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.MinorShield.BodySmall</item>
        <item name="textAppearanceCaption">@style/TextAppearance.MinorShield.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.MinorShield.Button</item>
    </style>

    <style name="Theme.MinorShieldEnfant.Splash" parent="Theme.MinorShieldEnfant">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
