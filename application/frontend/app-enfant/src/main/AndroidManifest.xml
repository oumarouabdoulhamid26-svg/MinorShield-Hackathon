<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifeste du MODULE ENFANT (bibliothèque).
    Il ne déclare plus d'icône de lancement : le mode enfant fait partie de
    l'application unique. Ses permissions et composants sont fusionnés dans
    le manifeste de l'app hôte au moment de la compilation.

    Ces permissions ne servent QU'AU mode enfant ; elles ne sont demandées
    à l'utilisateur que si l'appareil est configuré comme appareil enfant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Identifie l'app au premier plan pour dire au parent OÙ le contenu a été
         vu. S'active uniquement à la main dans les réglages Android. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Nécessaire (Android 11+) pour résoudre le nom lisible des apps
         surveillées via PackageManager. Usage légitime pour un contrôle parental. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>

        <!-- Écran d'accueil du mode enfant (plus de LAUNCHER : on y arrive
             depuis l'écran de choix du rôle, au premier démarrage). -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MinorShieldEnfant.Splash" />

        <activity
            android:name=".ui.PairingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MinorShieldEnfant" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MinorShieldEnfant" />

        <!-- Service overlay (polling lock-status) -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Service capture d'écran + analyse IA -->
        <service
            android:name=".service.ChildMonitoringService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
