APP_NAME="MinorShield API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Generate a long random value and keep it out of Git.
API_KEY=""

# Development can use ["*"]. Production must list trusted origins only.
ALLOWED_ORIGINS=["*"]
ENABLE_DOCS=true

OPENAI_API_KEY=""
HUGGINGFACE_TOKEN=""
EXTERNAL_TEXT_ANALYSIS_ENABLED=true

RATE_LIMIT_PER_MINUTE=30
HOST="0.0.0.0"
PORT=8000

DEFAULT_THRESHOLD=0.75
WEIGHT_IMAGE=0.60
WEIGHT_TEXT=0.40
CAPTURE_INTERVAL_MS=2000

MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_SIZE_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=12000000

STORE_IMAGES=false
